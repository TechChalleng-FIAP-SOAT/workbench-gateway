# Copy to terraform.tfvars (or pass via CI). Do NOT commit real values.

aws_region  = "us-east-1"
environment = "develop"

# Optional: guard the provider against deploying to the wrong account.
# Empty = no restriction (local validation). CI sets this from AWS_ACCOUNT_ID_<ENV>.
# aws_account_id = "123456789012"

# Backends: os NLBs INTERNOS dos 4 serviços são encontrados pela tag
# kubernetes.io/service-name (data "aws_lb" em data.tf) e alcançados por VPC Link.
# Os serviços precisam estar no ar antes do apply. Porta dos Services:
# service_port = 8080

# S3 bucket holding the workbench-lambda state (to read the functions' invoke ARNs).
# The key is derived automatically: lambda/<environment>/terraform.tfstate
lambda_state_bucket = "workbench-monolith-tfstate"

# Structured (JSON) access logs go to CloudWatch. Set to false only if another stack
# already manages the account-level API Gateway CloudWatch Logs role.
# manage_apigw_account = true
# log_retention_days   = 14
