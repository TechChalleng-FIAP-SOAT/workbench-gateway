{
  "openapi": "3.1.0",
  "info": {
    "title": "Workbench billing-service (AWS)",
    "version": "v0",
    "description": "Especificação gerada do billing-service em execução na AWS (17/11/2026). Rotas protegidas por JWT: use Authorize."
  },
  "servers": [
    {
      "url": "/__STAGE__",
      "description": "API Gateway (mesmo estágio desta página)"
    }
  ],
  "tags": [
    {
      "name": "Budget",
      "description": "Orçamento da OS"
    },
    {
      "name": "Payment",
      "description": "Pagamento (Mercado Pago) e histórico"
    }
  ],
  "paths": {
    "/api/payments/service-order/{serviceOrderId}": {
      "get": {
        "tags": [
          "Payment"
        ],
        "summary": "Buscar pagamento da OS",
        "operationId": "findByServiceOrder",
        "parameters": [
          {
            "name": "serviceOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Criar cobrança para a OS (pagamento pendente)",
        "operationId": "create",
        "parameters": [
          {
            "name": "serviceOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/payments/service-order/{serviceOrderId}/history": {
      "get": {
        "tags": [
          "Payment"
        ],
        "summary": "Histórico de pagamento da OS",
        "operationId": "history",
        "parameters": [
          {
            "name": "serviceOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/budgets/service-order/{serviceOrderId}": {
      "get": {
        "tags": [
          "Budget"
        ],
        "summary": "Buscar orçamento por OS",
        "operationId": "findByServiceOrder_1",
        "parameters": [
          {
            "name": "serviceOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BudgetResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "serviceOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "gatewayPaymentId": {
            "type": "string"
          },
          "checkoutUrl": {
            "type": "string"
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "BudgetResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "serviceOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "totalParts": {
            "type": "number"
          },
          "totalLabor": {
            "type": "number"
          },
          "totalPrice": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ItemResponse": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "itemType": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unitPrice": {
            "type": "number"
          },
          "totalPrice": {
            "type": "number"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT RS256 emitido pelas Lambdas: POST /auth (cliente, CPF) ou POST /auth/login (equipe)."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}