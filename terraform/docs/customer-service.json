          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "minimum": 1886
          },
          "color": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "CAR",
              "MOTORCYCLE",
              "TRUCK",
              "VAN"
            ]
          }
        },
        "required": [
          "brand",
          "model",
          "plate",
          "type",
          "year"
        ]
      },
      "VehicleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "clientId": {
            "type": "integer",
            "format": "int64"
          },
          "plate": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "color": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
