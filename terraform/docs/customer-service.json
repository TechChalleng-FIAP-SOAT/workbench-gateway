      "CreateVehicleRequest": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "integer",
            "format": "int64"
          },
          "plate": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "minimum": 1886
          },
          "color": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
