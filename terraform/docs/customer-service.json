          "name"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT RS256 emitido pelas Lambdas: POST /auth (cliente, CPF) ou POST /auth/login (equipe)."
      }
    }
