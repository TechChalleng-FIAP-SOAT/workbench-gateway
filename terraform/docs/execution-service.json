{
  "openapi": "3.1.0",
  "info": {
    "title": "Workbench execution-service (AWS)",
    "version": "v0",
    "description": "Especificação gerada do execution-service em execução na AWS (17/11/2026). Rotas protegidas por JWT: use Authorize."
  },
  "servers": [
    {
      "url": "/__STAGE__",
      "description": "API Gateway (mesmo estágio desta página)"
    }
  ],
  "tags": [
    {
      "name": "Stock",
      "description": "Estoque, disponibilidade e reservas"
    },
    {
      "name": "Product",
      "description": "Cadastro de peças e insumos"
    }
  ],
  "paths": {
    "/api/products/{id}": {
      "get": {
        "tags": [
          "Product"
        ],
        "summary": "Buscar produto por ID",
        "operationId": "findById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Product"
        ],
        "summary": "Atualizar peça/insumo",
        "description": "Substitui os dados cadastrais; o SKU continua único.",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Product"
        ],
        "summary": "Remover peça/insumo do catálogo",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/stocks": {
      "get": {
        "tags": [
          "Stock"
        ],
        "summary": "Listar estoques",
        "operationId": "findAll",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StockResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Stock"
        ],
        "summary": "Criar estoque para um produto",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/reservations": {
      "post": {
        "tags": [
          "Stock"
        ],
        "summary": "Reservar estoque para uma OS",
        "operationId": "reserve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservationResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/availability": {
      "post": {
        "tags": [
          "Stock"
        ],
        "summary": "Verificar disponibilidade de itens (para montar orçamento)",
        "operationId": "availability",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AvailabilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Product"
        ],
        "summary": "Listar produtos",
        "operationId": "findAll_1",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Product"
        ],
        "summary": "Adicionar peça/insumo ao catálogo",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/reservations/service-order/{serviceOrderId}/release": {
      "patch": {
        "tags": [
          "Stock"
        ],
        "summary": "Liberar reservas (volta ao estoque)",
        "operationId": "release",
        "parameters": [
          {
            "name": "serviceOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservationResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/reservations/service-order/{serviceOrderId}/confirm": {
      "patch": {
        "tags": [
          "Stock"
        ],
        "summary": "Confirmar reservas (baixa de estoque)",
        "operationId": "confirm",
        "parameters": [
          {
            "name": "serviceOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservationResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/product/{productId}/minimum": {
      "patch": {
        "tags": [
          "Stock"
        ],
        "summary": "Atualizar quantidade mínima",
        "operationId": "updateMinimum",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minimumQuantity",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/product/{productId}/exit": {
      "patch": {
        "tags": [
          "Stock"
        ],
        "summary": "Saída de estoque",
        "operationId": "exit",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovementRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/product/{productId}/entry": {
      "patch": {
        "tags": [
          "Stock"
        ],
        "summary": "Entrada de estoque",
        "operationId": "entry",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovementRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/reservations/service-order/{serviceOrderId}": {
      "get": {
        "tags": [
          "Stock"
        ],
        "summary": "Listar reservas de uma OS",
        "operationId": "findReservations",
        "parameters": [
          {
            "name": "serviceOrderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReservationResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/product/{productId}": {
      "get": {
        "tags": [
          "Stock"
        ],
        "summary": "Buscar estoque por produto",
        "operationId": "findByProduct",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StockResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stocks/low": {
      "get": {
        "tags": [
          "Stock"
        ],
        "summary": "Listar estoques abaixo do mínimo",
        "operationId": "findLow",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StockResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "PART",
              "SUPPLY"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "UNIT",
              "LITER",
              "MILLILITER",
              "KILOGRAM"
            ]
          },
          "category": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "costPrice": {
            "type": "number"
          },
          "salePrice": {
            "type": "number"
          },
          "manufacturerCode": {
            "type": "string"
          },
          "warrantyMonths": {
            "type": "integer",
            "format": "int32"
          },
          "fractionalAllowed": {
            "type": "boolean"
          },
          "packageSize": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "salePrice",
          "sku",
          "type",
          "unit"
        ]
      },
      "ProductResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PART",
              "SUPPLY"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "UNIT",
              "LITER",
              "MILLILITER",
              "KILOGRAM"
            ]
          },
          "category": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "costPrice": {
            "type": "number"
          },
          "salePrice": {
            "type": "number"
          },
          "active": {
            "type": "boolean"
          },
          "manufacturerCode": {
            "type": "string"
          },
          "warrantyMonths": {
            "type": "integer",
            "format": "int32"
          },
          "fractionalAllowed": {
            "type": "boolean"
          },
          "packageSize": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateStockRequest": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number"
          },
          "minimumQuantity": {
            "type": "number"
          }
        },
        "required": [
          "minimumQuantity",
          "productId",
          "quantity"
        ]
      },
      "StockResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "reservedQuantity": {
            "type": "number"
          },
          "availableQuantity": {
            "type": "number"
          },
          "minimumQuantity": {
            "type": "number"
          },
          "lowStock": {
            "type": "boolean"
          }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "ReserveRequest": {
        "type": "object",
        "properties": {
          "serviceOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "minItems": 1
          }
        },
        "required": [
          "items",
          "serviceOrderId"
        ]
      },
      "ReservationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "serviceOrderId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CONFIRMED",
              "RELEASED"
            ]
          }
        }
      },
      "AvailabilityRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "minItems": 1
          }
        },
        "required": [
          "items"
        ]
      },
      "AvailabilityResult": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "shortages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Shortage"
            }
          }
        }
      },
      "Shortage": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "requested": {
            "type": "number"
          },
          "available": {
            "type": "number"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MovementRequest": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "quantity"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT RS256 emitido pelas Lambdas: POST /auth (cliente, CPF) ou POST /auth/login (equipe)."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}